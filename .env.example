# Copy this file to .env and fill it in. .env is ignored by git and must never be committed.

# Testnet only. A fresh wallet used only for security tests and the testnet deploy.
# It holds free testnet BNB and nothing else. Never fund it on mainnet and never reuse a real wallet here.
# Create one with:  cast wallet new
SECURITY_TESTNET_KEY=
SECURITY_TESTNET_ADDRESS=

# Public nodes are enough. The fork tests need one that serves recent logs.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSC_RPC_URL=https://bsc-rpc.publicnode.com
